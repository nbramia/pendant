// Copy to Secrets.xcconfig (gitignored) and fill in your own values. `//` starts a comment in
// xcconfig, so build the URL with $(SLASH).
SLASH = /
// The ingest server (pendant_direct.ingest behind HTTPS, e.g. Tailscale Serve) and its token.
PENDANT_INGEST_URL = https:$(SLASH)$(SLASH)your-server.your-tailnet.ts.net:8443/pendant/ingest
PENDANT_INGEST_TOKEN = replace-me
// Your app's bundle ID; the widget and UI tests get .widgets / .uitests and the app group is group.<it>.
PENDANT_BUNDLE_ID = com.example.pendant
// Your Apple developer team ID (signing).
PENDANT_TEAM_ID = ABCDE12345
// What the app calls your server in its messages ("No connection to <name>"); empty: "the server".
PENDANT_SERVER_NAME =
// The Obsidian vault your notes are in, for "open in Obsidian" links; empty: no links.
PENDANT_OBSIDIAN_VAULT =
// Friendly pendant names by device ID: HEX=name,HEX=name (empty: the app shows IDs).
PENDANT_NAMES =
